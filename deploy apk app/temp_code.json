{
  "imports": [
    "import 'package:flutter/material.dart';",
    "import 'package:firebase_core/firebase_core.dart';",
    "import 'package:cloud_firestore/cloud_firestore.dart';",
    "import 'dart:async';",
    "import 'package:fl_chart/fl_chart.dart';",
    "import 'package:intl/intl.dart';",
    "import '../firebase_options.dart';",
    "import '../services/auth_service.dart';",
    "import '../widgets/iaq_chart.dart';",
    "import 'login_screen.dart';"
  ],
  "state_variables": [
    "List<Map<String, dynamic>> _recentReadings = [];",
    "List<FlSpot> _iaqDataPoints = [];", 
    "StreamSubscription<QuerySnapshot>? _readingsSubscription;",
    "bool _isInitialized = false;",
    "String _initError = '';",
    "double _minY = 0;",
    "double _maxY = 100;"
  ],
  "init_firebase": [
    "  Future<void> _initFirebase() async {",
    "    try {",
    "      await Firebase.initializeApp(",
    "        options: DefaultFirebaseOptions.currentPlatform,",
    "      );",
    "      setState(() => _isInitialized = true);",
    "      _setupReadingsListener();",
    "    } catch (e) {",
    "      setState(() => _initError = e.toString());",
    "      print('Firebase init error: $e');",
    "    }",
    "  }"
  ],
  "setup_listener": [
    "  void _setupReadingsListener() {",
    "    if (!_isInitialized) return;",
    "",
    "    try {",
    "      _readingsSubscription = FirebaseFirestore.instance",
    "          .collection('readings')",
    "          .orderBy('datetime', descending: true)",
    "          .limit(5)",
    "          .snapshots()",
    "          .listen(",
    "        (snapshot) {",
    "          // Xử lý dữ liệu cho bảng",
    "          final readings = snapshot.docs.map((doc) {",
    "            final data = doc.data();",
    "            return {",
    "              'timestamp': data['datetime']?.toString() ?? '',",
    "              'temp': data['temperature_c']?.toStringAsFixed(2) ?? '—',",
    "              'humidity': data['humidity_pct']?.toStringAsFixed(1) ?? '—',",
    "              'eCO2': data['eCO2_ppm']?.toString() ?? '—',",
    "              'tvoc': data['TVOC_ppb']?.toString() ?? '—',",
    "              'iaq': data['IAQ']?.toString() ?? '—',",
    "            };",
    "          }).toList();",
    "",
    "          // Xử lý dữ liệu cho biểu đồ",
    "          final iaqPoints = snapshot.docs.map((doc) {",
    "            final data = doc.data();",
    "            final timestamp = DateTime.parse(data['datetime'].toString());",
    "            final iaq = data['IAQ'] as num;",
    "            return FlSpot(",
    "              timestamp.millisecondsSinceEpoch.toDouble(),",
    "              iaq.toDouble(),",
    "            );",
    "          }).toList().reversed.toList(); // Đảo ngược để hiển thị theo thứ tự thời gian",
    "",
    "          setState(() {",
    "            _recentReadings = readings;",
    "            _iaqDataPoints = iaqPoints;",
    "            // Cập nhật giá trị min/max cho trục Y",
    "            if (iaqPoints.isNotEmpty) {",
    "              _minY = iaqPoints",
    "                  .map((point) => point.y)",
    "                  .reduce((a, b) => a < b ? a : b);",
    "              _maxY = iaqPoints",
    "                  .map((point) => point.y)",
    "                  .reduce((a, b) => a > b ? a : b);",
    "              // Thêm padding cho trục Y",
    "              _minY = (_minY - 10).clamp(0, 100);",
    "              _maxY = (_maxY + 10).clamp(0, 100);",
    "            }",
    "          });",
    "        },",
    "        onError: (error) {",
    "          print('Firestore listen error: $error');",
    "          setState(() {",
    "            _initError = error.toString();",
    "          });",
    "        },",
    "      );",
    "    } catch (e) {",
    "      print('Setup listener error: $e');",
    "      setState(() {",
    "        _initError = e.toString();",
    "      });",
    "    }",
    "  }"
  ],
  "dispose": [
    "  @override",
    "  void dispose() {",
    "    _readingsSubscription?.cancel();",
    "    super.dispose();",
    "  }"
  ]
}